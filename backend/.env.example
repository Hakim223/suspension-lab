# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database (use either DATABASE_URL or the discrete DB_* variables) ---
# DATABASE_URL=mysql://user:password@host:3306/suspension_lab
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=suspension_lab
DB_PASSWORD=change-me
DB_NAME=suspension_lab
# Set to true for managed MySQL providers that require TLS
DB_SSL=false
# Set to false only if your provider uses a self-signed certificate you cannot verify
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Number of reverse proxies in front of the app (Render/Railway: 1)
TRUST_PROXY=1
